{
  "swagger": "2.0",
  "info": {
    "title": "Movies API",
    "description": "API for managing movie records.",
    "version": "1.0.0"
  },
  "host": "localhost:3001",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/api-docs": {
      "get": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Hello World"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/movies/": {
      "get": {
        "tags": [
          "Movies"
        ],
        "description": "",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Returns all movies from the collection.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Movie"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Movies"
        ],
        "description": "",
        "responses": {
          "201": {
            "description": "Movie created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "acknowledged": {
                      "type": "boolean"
                    },
                    "insertedId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation failed."
          },
          "412": {
            "description": "Precondition Failed"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Movie"
              },
              "examples": {
                "movie": {
                  "$ref": "#/components/examples/Movie"
                }
              }
            }
          }
        }
      }
    },
    "/movies/{id}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "description": "",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Movie ID to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a single movie by ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied (must be 24 hex characters)."
          },
          "404": {
            "description": "Movie not found."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "tags": [
          "Movies"
        ],
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Movie ID to update."
          }
        ],
        "responses": {
          "204": {
            "description": "Movie updated successfully (No Content)."
          },
          "400": {
            "description": "Invalid ID supplied or Validation failed."
          },
          "412": {
            "description": "Precondition Failed"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Movie"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Movies"
        ],
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Movie ID to delete."
          }
        ],
        "responses": {
          "204": {
            "description": "Movie deleted successfully (No Content)."
          },
          "400": {
            "description": "Invalid ID supplied."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Movie": {
        "$name": "The Great Movie",
        "$genre": "Action",
        "$subgenre": "Sci-Fi",
        "$releaseYear": 2024,
        "$rating": 8.5,
        "$countryOfOrigin": "USA",
        "$language": "English"
      }
    },
    "examples": {
      "Movie": {
        "value": {
          "name": "The Great Movie",
          "genre": "Action",
          "subgenre": "Sci-Fi",
          "releaseYear": 2024,
          "rating": 8.5,
          "countryOfOrigin": "USA",
          "language": "English"
        }
      }
    }
  }
}